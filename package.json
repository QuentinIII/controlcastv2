{
  "name": "controlcast",
  "productName": "ControlCast",
  "version": "0.4.1",
  "description": "ControlCast - Launchpad controller for streamers",
  "main": "app/index.js",
  "homepage": "https://github.com/QuentinIII/controlcastv2",
  "author": "DBKynd",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@jitsi/robotjs": "0.6.24",
    "@julusian/midi": "3.9.0",
    "express": "^4.21.2",
    "jquery": "^3.7.1",
    "keycode": "^2.2.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.controlcast.app",
    "productName": "ControlCast",
    "copyright": "Copyright (C) 2016 DBKynd",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json",
      "!app/clr/assets/images/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app/images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "ControlCast",
      "installerIcon": "app/images/icon.ico",
      "uninstallerIcon": "app/images/icon.ico",
      "artifactName": "ControlCast-Setup-${version}.${ext}"
    },
    "publish": null
  }
}
